# Copy this file to .env for local development. Do not commit .env.
POSTGRES_DB=tactical_match_breaker
POSTGRES_USER=tactical_app
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_PORT=5433
DATABASE_URL=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Docker Compose keeps video storage at the fixed persistent mount /app/data/videos.
MAX_VIDEO_UPLOAD_BYTES=524288000
VIDEO_ALLOWED_FORMATS=mp4,webm
